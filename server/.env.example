# --- Base ---
PORT=4400
NODE_ENV=development
# En production : chaîne robuste et unique (ex. `openssl rand -hex 32`).
# Le serveur refuse de démarrer en prod si cette valeur est absente ou par défaut.
JWT_SECRET=change-me-in-prod

# Origine(s) autorisée(s) pour CORS (séparées par des virgules en prod).
CLIENT_URL=http://localhost:5273
# URL publique de l'app, utilisée dans les liens des e-mails (vérif / reset).
APP_URL=http://localhost:5273

# Chemin du fichier SQLite (laisser vide pour ./myco.db).
# En prod OVH, pointer vers un volume persistant, ex. /var/lib/myco/myco.db
DATABASE_FILE=

# --- Fournisseur d'identification IA ---
# demo (par défaut) | bioclip | openai
AI_PROVIDER=demo
BIOCLIP_URL=http://127.0.0.1:5000
OPENAI_API_KEY=

# --- SMTP (e-mails de vérification et de réinitialisation) ---
# Si non renseigné, les e-mails ne sont pas envoyés : le lien est journalisé.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Myco <no-reply@mon-domaine.fr>

# --- Myco Premium ---
# true = fonctionnalités Premium ouvertes à tous (lancement gratuit, tests).
PREMIUM_FOR_ALL=false

# Stripe (laisser vide tant que le compte n'est pas créé : l'abonnement
# s'affiche alors « bientôt disponible »). Commencer avec les clés de TEST.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PRICE_MONTHLY_LABEL=2,99 € / mois
PRICE_YEARLY_LABEL=19 € / an

# Météo (alertes de poussée) — Open-Meteo. Gratuit en non-commercial ;
# avec Premium payant, prendre une offre API et renseigner la clé.
OPEN_METEO_API_KEY=
WEATHER_CACHE_HOURS=6
# Seuil d'alerte (indice 0-100) et délai minimal entre deux alertes d'un même coin.
FLUSH_ALERT_THRESHOLD=60
FLUSH_ALERT_COOLDOWN_DAYS=7

# Notifications push : `npx web-push generate-vapid-keys` (une seule fois,
# ne plus changer ensuite sinon les abonnements existants deviennent invalides).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@app-fair.fr

# --- Sortie : véhicule, trace et suivi par les proches ---
# La veille tourne dans le processus de l'API (pas de timer systemd à ajouter).
# OUTING_WATCHDOG=off pour la désactiver (ex. si plusieurs instances de l'API).
OUTING_WATCHDOG_SECONDS=120
# Délai après l'heure de retour prévue avant d'alerter les proches (minutes).
OUTING_GRACE_MIN=30
# Sans aucune position reçue pendant ce délai, les proches sont informés (minutes).
OUTING_SILENCE_MIN=60
# Sortie oubliée : clôturée automatiquement ce délai après l'heure de retour (heures).
OUTING_EXPIRE_HOURS=24
# Durée de validité du lien de suivi après la fin de la sortie (heures).
OUTING_FOLLOW_TTL_HOURS=24
# Conservation des traces GPS après la fin de la sortie (jours, RGPD).
OUTING_RETENTION_DAYS=30
